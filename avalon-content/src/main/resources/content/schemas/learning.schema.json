{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "物种技能学习池",
  "description": "学习资格关系；技能书的技能和等级在 items.json 中维护。",
  "$comment": "物种技能池与个体当前技能分离；扩大技能池不会自动补发技能。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "pools": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "uniqueItems": true,
        "description": "允许操作的地点编号列表。"
      },
      "description": "按物种编号索引的可学习技能池。"
    }
  },
  "required": [
    "$schema",
    "pools"
  ],
  "additionalProperties": false
}
