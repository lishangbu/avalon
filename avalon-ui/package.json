{
  "name": "avalon-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:typecheck": "vue-tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests *.ts *.json .prettierrc.json",
    "format:check": "prettier --check src tests *.ts *.json .prettierrc.json"
  },
  "dependencies": {
    "@ionic/vue": "9.0.13",
    "@ionic/vue-router": "9.0.13",
    "@tanstack/vue-query": "5.108.3",
    "ionicons": "8.1.1",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
