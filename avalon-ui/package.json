{
  "name": "avalon-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests simulations *.ts *.json .prettierrc.json",
    "format:check": "prettier --check src tests simulations *.ts *.json .prettierrc.json",
    "test:simulation": "playwright test --config=playwright.api.config.ts"
  },
  "dependencies": {
    "@ionic/vue": "9.0.7",
    "@ionic/vue-router": "9.0.7",
    "@tanstack/vue-query": "5.104.2",
    "ionicons": "8.1.0",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
