    {
      "id": "AD",
      "name": "阿德",
      "role": "村长",
      "description": "熟悉晨露村每一条小路，谈起年轻时的远行总会多说几句。比起催人出发，他更在意行囊是否准备妥当。",
      "services": [],
      "greeting": "来了？坐一会儿，出发的事可以慢慢说。"
    },
    {
      "id": "BRUNO",
      "name": "布鲁诺",
      "role": "武器匠",
      "description": "每天开店前都会检查柜台上的刀刃和绑带。他相信一件趁手的装备，应当让初次远行的人也用得安心。",
      "services": [
        "SHOP"
      ],
      "greeting": "看看有没有趁手的，绑带松了也可以找我。"
    },
    {
      "id": "MESHA",
      "name": "梅莎",
      "role": "幻兽护理员",
      "description": "能从脚步声辨认常来的幻兽。她总是先安抚紧张的伙伴，再耐心检查伤处。",
      "services": [
        "RECOVERY",
        "STORAGE",
        "RESEARCH_FOLLOWUP"
      ],
      "greeting": "先让伙伴歇歇，哪里不舒服都可以告诉我。"
    },
    {
