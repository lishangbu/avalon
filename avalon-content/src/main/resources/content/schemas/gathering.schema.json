{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "生活采集资源点",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "enum": [
              "MINING",
              "LOGGING",
              "HERBALISM",
              "HUNTING"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "rare": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "skill",
          "level",
          "location",
          "product",
          "quantity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "nodes"
  ],
  "additionalProperties": false
}
