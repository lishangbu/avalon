{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./schemas/fishing.schema.json"
    },
    "bait": {
      "type": "string",
      "minLength": 1
    },
    "fish": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "points": {
            "type": "integer",
            "minimum": 1
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "level",
          "difficulty",
          "points",
          "locations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "bait",
    "fish"
  ],
  "additionalProperties": false
}
