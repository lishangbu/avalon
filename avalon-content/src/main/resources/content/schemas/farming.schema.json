{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "个人农田与作物",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "initialPlots": {
      "const": 6
    },
    "maximumPlots": {
      "const": 24
    },
    "expansionGold": {
      "type": "integer",
      "minimum": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "crops": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "growthSeconds": {
            "enum": [
              900,
              3600,
              14400
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "points": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "seed",
          "product",
          "level",
          "growthSeconds",
          "quantity",
          "points"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "initialPlots",
    "maximumPlots",
    "expansionGold",
    "locations",
    "crops"
  ],
  "additionalProperties": false
}
