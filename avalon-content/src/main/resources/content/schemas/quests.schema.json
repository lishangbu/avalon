{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "阿瓦隆正式任务目录",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./schemas/quests.schema.json"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "quest",
          "title",
          "location",
          "label",
          "dialogue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quest": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "npcId": {
            "type": [
              "string",
              "null"
            ]
          },
          "acceptance": {
            "type": "object",
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "type": "string",
                "minLength": 1
              },
              "npcId": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "dialogue": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "completes": {
            "type": "boolean"
          },
          "environmental": {
            "type": "boolean"
          },
          "onArrival": {
            "type": "boolean"
          },
          "minimumActive": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "placement": {
            "type": "object",
            "properties": {
              "sourcePrefix": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "sourcePrefix",
              "position"
            ],
            "additionalProperties": false
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            }
          },
          "acceptEffects": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/effect"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "GIVE_ITEM"
                    }
                  }
                }
              ]
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objectives": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/objective"
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/condition"
                }
              },
              "effects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/runtimeEffect"
                }
              },
              "delivery": {
                "enum": [
                  "AUTO",
                  "MANUAL"
                ]
              },
              "branch": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "group",
                  "option"
                ],
                "properties": {
                  "group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "option": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "timeout": {
                "$ref": "#/$defs/timeout"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "environmental": {
                  "const": true
                }
              },
              "required": [
                "environmental"
              ]
            },
            "then": {
              "required": [
                "facts"
              ],
              "properties": {
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "npcId": {
                  "type": "null"
                },
                "onArrival": {
                  "const": false
                }
              },
              "allOf": [
                {
                  "if": {
                    "not": {
                      "required": [
                        "runtime"
                      ]
                    }
                  },
                  "then": {
                    "properties": {
                      "facts": {
                        "anyOf": [
                          {
                            "maxItems": 0
                          },
                          {
                            "contains": {
                              "type": "string",
                              "pattern": "^(SCENE:|VICTORY:|TRAINING:|VISIT:|READINESS:)"
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "else": {
              "required": [
                "npcId"
              ],
              "properties": {
                "npcId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "effect": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "EXPERIENCE",
            "GOLD",
            "GIVE_ITEM",
            "TAKE_ITEM",
            "GIVE_PET",
            "GIVE_EQUIPMENT"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "amount"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "EXPERIENCE",
                  "GOLD"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "reference"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "GIVE_PET",
                  "GIVE_EQUIPMENT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "amount": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "timeout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "required": [
            "relativeSeconds"
          ],
          "not": {
            "required": [
              "deadline"
            ]
          }
        },
        {
          "required": [
            "deadline"
          ],
          "not": {
            "required": [
              "relativeSeconds"
            ]
          }
        }
      ]
    },
    "runtimeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amount"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "measure",
        "code",
        "amount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "enum": [
            "EVENT",
            "HOLDING",
            "HISTORY"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "$schema",
    "steps"
  ],
  "additionalProperties": false
}
