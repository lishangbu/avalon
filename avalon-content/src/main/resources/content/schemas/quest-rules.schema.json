{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "任务规则与展示标签",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "tags", "quests"],
  "properties": {
    "$schema": {"const": "./schemas/quest-rules.schema.json"},
    "tags": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "quests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "type", "tags", "repeatPolicy"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "type": {"enum": ["MAIN", "SIDE"]},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "repeatPolicy": {"const": "ONCE"},
          "abandonable": {"type": "boolean", "description": "省略时主线为false、支线为true；主线禁止配置为true"}
        },
        "allOf": [{
          "if": {"properties": {"type": {"const": "MAIN"}}},
          "then": {"properties": {"abandonable": {"const": false}}}
        }]
      }
    }
  }
}
