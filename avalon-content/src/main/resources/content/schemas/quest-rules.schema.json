{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "任务规则与展示标签",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "tags",
    "quests"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "tags",
          "policy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "MAIN",
              "SIDE"
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abandonable": {
            "type": "boolean",
            "description": "省略时主线为false、支线为true；主线禁止配置为true"
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "ringSize",
              "repeatPolicy",
              "timezone",
              "retryable",
              "ringRewards"
            ],
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              },
              "ringSize": {
                "type": "integer",
                "minimum": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "timeout": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relativeSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "relativeSeconds"
                    ],
                    "not": {
                      "required": [
                        "deadline"
                      ]
                    }
                  },
                  {
                    "required": [
                      "deadline"
                    ],
                    "not": {
                      "required": [
                        "relativeSeconds"
                      ]
                    }
                  }
                ]
              },
              "ringRewards": {
                "type": "array",
                "items": {
                  "$ref": "classpath:content/schemas/quests.schema.json#/$defs/runtimeEffect"
                }
              },
              "repeatPolicy": {
                "enum": [
                  "ONCE",
                  "DAILY",
                  "WEEKLY",
                  "RING"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "MAIN"
                }
              }
            },
            "then": {
              "properties": {
                "abandonable": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
