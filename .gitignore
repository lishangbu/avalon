# Maven 编译产物、测试报告及项目内下载的前端工具
target/
.flattened-pom.xml

# 部署及验收 Python 脚本缓存
__pycache__/
*.pyc

# 前端依赖、生产产物与浏览器测试输出
node_modules/
dist/
playwright-report/
test-results/

# 本地验收证据与运行产物，不作为源码发布
/outputs/

# 本地凭据与运行日志；可提交不含秘密的配置模板
.env
.env.*
!.env.example
!.env.*.example
*.log
deploy/application-prod.yaml

# 编辑器个人状态；共享 VS Code 配置可纳入版本控制
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
out/

# 操作系统临时文件
.DS_Store
Thumbs.db
*~
