# Maven 编译产物、测试报告及项目内下载的前端工具
target/
.flattened-pom.xml

# 部署及验收 Python 脚本缓存
__pycache__/
*.pyc

# 前端依赖、生产产物与浏览器测试输出
node_modules/
dist/
playwright-report*/
blob-report*/
# 同时忽略 --output 指定的布局验收、恢复验收等带后缀目录。
test-results*/
simulation-results/

# 本地验收证据与运行产物，不作为源码发布
/outputs/

# 本地凭据与运行日志；可提交不含秘密的配置模板
.env
.env.*
!.env.example
!.env.*.example
*.log

# 编辑器个人状态；共享 VS Code 配置可纳入版本控制
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
out/

# 操作系统临时文件
.DS_Store
Thumbs.db
*~

# 生产数据库密码独立保管
/deploy/postgres-password.txt

# PostgreSQL 宿主机持久化目录
/deploy/postgresql/

# 战斗文本记录含完整内部状态，仅作为运行数据和导出证据保存。
logs/
/deploy/battle-logs/

# OpenJ9 共享类缓存
/deploy/openj9-cache/
