      "name": "特林",
      "role": "庆典筹办人",
      "description": "随身带着写满事项的小册子，忙碌时也不忘招呼路过的邻居。让大家平安热闹地过节，是他最在意的事。",
      "services": [],
      "greeting": "来得正好！今天广场上的事可不少。"
    },
    {
      "id": "KLEIN",
      "name": "克林",
      "role": "学院接待员",
      "description": "把新生写错的表格整齐收在一旁，从不因此责备谁。他会逐项解释手续，让第一次来学院的人也能找到方向。",
      "services": [],
      "greeting": "欢迎来到诺姆学院。我们一项一项来，不着急。"
    },
    {
      "id": "FEYN",
      "name": "费恩",
      "role": "实践课导师",
      "description": "喜欢先听学生说完观察，再提出一个恰到好处的问题。他认为亲手尝试留下的印象，比背熟答案更长久。",
      "services": [
        "ACADEMY",
        "WORKSHOP"
      ],
      "greeting": "先说说你看到了什么，再想想为什么。"
    },
    {
      "id": "MILA",
      "name": "米菈",
      "role": "冒险指导员",
      "description": "善于把复杂的准备工作拆成几件小事。遇到犹豫的新手，她会先陪对方确认下一步能做什么。",
      "services": [],
      "greeting": "准备好下一步了吗？我们一起检查一下。"
    },
    {
      "id": "TRAVEL_MERCHANT",
      "name": "旅行商人",
      "role": "行商",
      "description": "行囊上挂着沿途收来的小饰物。谈起道路和天气，他往往比谈价钱更起劲。",
      "services": [],
      "greeting": "路上还顺利吗？前面的路标可别错过。"
    },
    {
      "id": "STATION_KEEPER",
      "name": "小站看护人",
