{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "quests"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "tags",
          "policy",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "MAIN",
              "SIDE"
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "abandonable": {
            "type": "boolean",
            "description": "省略时主线为false、支线为true；主线禁止配置为true"
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limit",
              "ringSize",
              "repeatPolicy",
              "timezone",
              "retryable",
              "ringRewards"
            ],
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              },
              "ringSize": {
                "type": "integer",
                "minimum": 1
              },
              "retryable": {
                "type": "boolean"
              },
              "timeout": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "relativeSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "relativeSeconds"
                    ],
                    "not": {
                      "required": [
                        "deadline"
                      ]
                    }
                  },
                  {
                    "required": [
                      "deadline"
                    ],
                    "not": {
                      "required": [
                        "relativeSeconds"
                      ]
                    }
                  }
                ]
              },
              "ringRewards": {
                "type": "array",
                "items": {
                  "$ref": "classpath:content/schemas/quests.schema.json#/$defs/runtimeEffect"
                }
              },
              "repeatPolicy": {
                "enum": [
                  "ONCE",
                  "DAILY",
                  "WEEKLY",
                  "RING"
                ]
              }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "quest",
                "title",
                "location",
                "label",
                "dialogue",
                "objectives",
                "conditions",
                "delivery",
                "acceptance",
                "acceptEffects",
                "requires",
                "conversations"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "quest": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "type": "string",
                  "minLength": 1
                },
                "npcId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "acceptance": {
                  "type": "object",
                  "required": [
                    "location"
                  ],
                  "properties": {
                    "explicit": {
                      "type": "boolean",
                      "description": "即使章节已参与，此步骤仍须在指定地点单独正式接取；缺省为false。"
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1
                    },
                    "npcId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "dialogue": {
                  "type": "string",
                  "minLength": 1
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "completes": {
                  "type": "boolean"
                },
                "environmental": {
                  "type": "boolean"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "enum": [
                              "EXPERIENCE",
                              "GOLD",
                              "GIVE_ITEM",
                              "TAKE_ITEM",
                              "TAKE_PET",
                              "GIVE_PET",
                              "GIVE_EQUIPMENT"
                            ]
                          },
                          "reference": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1
                          },
                          "amount": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "required": [
                          "kind",
                          "amount"
                        ],
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "EXPERIENCE",
                                    "GOLD"
                                  ]
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "reference": {
                                  "type": "null"
                                }
                              }
                            },
                            "else": {
                              "required": [
                                "reference"
                              ],
                              "properties": {
                                "reference": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          },
                          {
                            "if": {
                              "properties": {
                                "kind": {
                                  "enum": [
                                    "GIVE_PET",
                                    "GIVE_EQUIPMENT"
                                  ]
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "amount": {
                                  "const": 1
                                }
                              }
                            }
                          }
                        ]
                      },
                      {
                        "allOf": [
                          {
                            "$ref": "quests.schema.json#/$defs/runtimeEffect"
                          },
                          {
                            "properties": {
                              "kind": {
                                "not": {
                                  "enum": [
                                    "GOLD",
                                    "EXPERIENCE",
                                    "GIVE_ITEM",
                                    "TAKE_ITEM",
                                    "TAKE_PET",
                                    "GIVE_PET",
                                    "GIVE_EQUIPMENT"
                                  ]
                                }
                              }
                            }
                          }
                        ]
                      }
                    ]
                  }
                },
                "acceptEffects": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "quests.schema.json#/$defs/effect"
                      },
                      {
                        "properties": {
                          "kind": {
                            "const": "GIVE_ITEM"
                          }
                        }
                      }
                    ]
                  }
                },
                "objectives": {
                  "type": "array",
                  "items": {
                    "$ref": "quests.schema.json#/$defs/objective"
                  }
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "$ref": "quests.schema.json#/$defs/condition"
                  }
                },
                "delivery": {
                  "enum": [
                    "AUTO",
                    "MANUAL"
                  ]
                },
                "branch": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "group",
                        "option"
                      ],
                      "properties": {
                        "group": {
                          "type": "string",
                          "minLength": 1
                        },
                        "option": {
                          "type": "string",
                          "minLength": 1
                        },
                        "mode": {
                          "enum": [
                            "EXCLUSIVE",
                            "SWITCHABLE"
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "timeout": {
                  "anyOf": [
                    {
                      "$ref": "quests.schema.json#/$defs/timeout"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "conversations": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "offer",
                    "accepted",
                    "progress",
                    "ready",
                    "revisit",
                    "resume"
                  ],
                  "properties": {
                    "offer": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    },
                    "accepted": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    },
                    "progress": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    },
                    "ready": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    },
                    "revisit": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    },
                    "resume": {
                      "$ref": "quest-dialogues.schema.json#/$defs/text"
                    }
                  }
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "required": [
                      "environmental"
                    ],
                    "properties": {
                      "environmental": {
                        "const": true
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "npcId": {
                        "type": "null"
                      },
                      "objectives": {
                        "items": {
                          "properties": {
                            "code": {
                              "not": {
                                "pattern": "^QUEST:"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "required": [
                      "npcId"
                    ],
                    "properties": {
                      "npcId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "MAIN"
                }
              }
            },
            "then": {
              "properties": {
                "abandonable": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
