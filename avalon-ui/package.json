{
  "name": "avalon-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:typecheck": "vue-tsc -p tsconfig.tests.json",
    "format": "prettier --write src tests *.ts *.json .prettierrc.json",
    "format:check": "prettier --check src tests *.ts *.json .prettierrc.json"
  },
  "dependencies": {
    "@ionic/vue": "9.0.8",
    "@ionic/vue-router": "9.0.8",
    "@tanstack/vue-query": "5.104.3",
    "ionicons": "8.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
